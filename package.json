{
  "name": "jungle-gaming-challenge",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "bun run src/main.ts",
    "start:dev": "bun --watch run src/main.ts",
    "build": "bun build src/main.ts --outdir dist --target bun",
    "test": "bun test",
    "test:unit": "bun test src/**/*.unit.spec.ts",
    "test:integration": "bun test src/**/*.integration.spec.ts",
    "test:concurrency": "bun test src/**/*.concurrency.spec.ts",
    "migration:create": "bun run src/database/run-migration.ts create",
    "migration:up": "bun run src/database/run-migration.ts up",
    "migration:down": "bun run src/database/run-migration.ts down",
    "lint": "bunx @biomejs/biome check src/",
    "format": "bunx @biomejs/biome format --write src/"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/schedule": "^5.0.0",
    "@mikro-orm/core": "^6.4.0",
    "@mikro-orm/postgresql": "^6.4.0",
    "@mikro-orm/migrations": "^6.4.0",
    "@mikro-orm/nestjs": "^6.0.0",
    "@aws-sdk/client-sqs": "^3.700.0",
    "decimal.js": "^10.4.3",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "uuid": "^11.0.0",
    "pino": "^9.0.0",
    "pino-pretty": "^13.0.0",
    "class-validator": "^0.14.0",
    "class-transformer": "^0.5.0"
  },
  "devDependencies": {
    "@types/uuid": "^10.0.0",
    "@types/express": "^5.0.0",
    "typescript": "^5.7.0",
    "@biomejs/biome": "^1.9.0",
    "bun-types": "^1.1.0"
  }
}
