# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=jungle_gaming
DATABASE_USER=jungle
DATABASE_PASSWORD=jungle_secret

# SQS
SQS_ENDPOINT=http://localhost:4566
SQS_REGION=us-east-1
SQS_WAGER_QUEUE_URL=http://localhost:4566/000000000000/wager-transactions.fifo
SQS_WAGER_DLQ_URL=http://localhost:4566/000000000000/wager-transactions-dlq.fifo

# App
APP_PORT=3000
NODE_ENV=development
LOG_LEVEL=debug

# Outbox
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=10

# Pending Reference
PENDING_REFERENCE_POLL_INTERVAL_MS=5000
PENDING_REFERENCE_MAX_ATTEMPTS=10
PENDING_REFERENCE_TTL_MINUTES=60
